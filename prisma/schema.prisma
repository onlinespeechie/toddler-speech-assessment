datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model QuestionSequence {
  id        String   @id @default(cuid())
  title     String   // e.g. "0-12 months"
  minMonths Int
  maxMonths Int
  
  placements SequencePlacement[]
}

model Question {
  id                 String           @id @default(cuid())
  text               String
  videoUrl           String?
  internalCode       String?          @unique
  category           String?
  
  options            Option[]
  placements         SequencePlacement[]
}

model SequencePlacement {
  id           String   @id @default(cuid())
  order        Int      @default(0)
  isScored     Boolean  @default(true)
  questionType String?
  
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  sequenceId String
  sequence   QuestionSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  
  @@unique([sequenceId, questionId])
}

model Option {
  id         String   @id @default(cuid())
  text       String
  weight     Int      @default(0) // 0, 5, or 10 (or 0 for tag questions)
  tagValue   String?  // Optional tag string specifically bound to tag questions
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Submission {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  parentName         String   @default("Unknown")
  parentEmail        String   @default("Unknown")
  childDob           DateTime @default(now())
  totalScore         Int      @default(0)
  scoreStatus        String   @default("Unknown")
  communicationStage String   @default("Unknown")
  speechClarity      String?
  answers            Answer[]
}

model Answer {
  id           String     @id @default(cuid())
  questionId   String     @default("Unknown")
  questionText String     @default("Unknown")
  value        String     @default("Unknown")
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}
